# Copiá este archivo como ".env" en la raíz del proyecto (o en el directorio
# que indiques con MOVIES_DOTENV_DIRECTORY) y completá los valores.
# El archivo ".env" no debe commitearse.

# URL JDBC completa (opcional; si no se define, se usa localhost/movies_cac)
MOVIES_JDBC_URL=jdbc:mysql://localhost:3306/movies_cac

# Usuario MySQL (opcional; por defecto root)
MOVIES_DB_USER=root

# Contraseña MySQL (obligatoria vía .env o variable de entorno del sistema)
MOVIES_DB_PASSWORD=tu_password

# Opcional: carpeta donde está el archivo .env (útil si Tomcat no arranca
# con el directorio de trabajo en la raíz del repo). Ejemplo en Windows:
# MOVIES_DOTENV_DIRECTORY=C:\Proyectos\Codo A Codo\Java\api-peliculas
